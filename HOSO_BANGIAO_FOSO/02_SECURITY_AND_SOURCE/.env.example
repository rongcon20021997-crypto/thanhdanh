# ==============================================================================
# FOSO ENTERPRISE ERP / MES / HRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env hoặc định nghĩa trong VirtualHost / System Environment
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
CI_ENV=production
APP_BASE_URL=https://erp.yourdomain.com/
APP_ENCRYPTION_KEY=GenerateAStrong32CharacterSecretKeyHere!

# --- DATABASE CONNECTION (MYSQL / MARIADB) ---
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_USERNAME=foso_db_user
DB_PASSWORD=SecurePasswordHere123!
DB_DATABASE=foso_production_db
DB_CHARSET=utf8mb4
DB_COLLAT=utf8mb4_unicode_ci

# --- ZALO OPEN PLATFORM API ---
ZALO_OA_APP_ID=123456789012345678
ZALO_OA_SECRET_KEY=YourZaloSecretKeyHere
ZALO_OA_ACCESS_TOKEN=YourZaloOAAccessTokenHere
ZALO_OA_REFRESH_TOKEN=YourZaloOARefreshTokenHere

# --- OPENAI / AI CHATGPT INTEGRATION ---
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# --- POWER BI EMBEDDED INTEGRATION ---
POWER_BI_CLIENT_ID=your-azure-ad-client-id
POWER_BI_CLIENT_SECRET=your-azure-ad-client-secret
POWER_BI_TENANT_ID=your-azure-tenant-id
POWER_BI_WORKSPACE_ID=your-powerbi-workspace-id

# --- SMTP MAIL CONFIGURATION ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notification@yourdomain.com
SMTP_PASS=YourEmailAppPassword
SMTP_CRYPTO=tls
SMTP_FROM_NAME="Foso ERP System"

# --- SYSTEM & BACKUP PATHS ---
BACKUP_STORAGE_DIR=/var/backups/foso/
BACKUP_RETENTION_DAYS=30
LOG_RETENTION_DAYS=60
MAX_UPLOAD_SIZE_MB=50
